# Site (Stripe redirect URLs)
SITE_URL=https://www.velorabeauty.world

# SQLite (Easypanel volume /app/data)
DATABASE_PATH=/app/data/velora.sqlite

# Stripe — set in Easypanel secrets only (never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
CARD_PAYMENT_ENABLED=true
NEXT_PUBLIC_CARD_PAYMENT_ENABLED=false

# Abandoned-checkout backend (server only — never prefix with NEXT_PUBLIC_)
# Origin only, no path. Example: https://api.velorabeauty.world
BACKEND_API_BASE_URL=https://api.velorabeauty.world
STORE_API_KEY=
# none: backend sweep marks a quiet checkout abandoned after 30 minutes (do not heartbeat)
# immediate: also POST /api/checkouts/:id/abandon right after upsert
# delayed: this server calls /abandon after BACKEND_ABANDON_DELAY_MINUTES
BACKEND_CHECKOUT_ABANDON_MODE=none
BACKEND_ABANDON_DELAY_MINUTES=30
