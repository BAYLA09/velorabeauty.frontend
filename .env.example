# Site (Stripe redirect URLs)
SITE_URL=https://www.velorabeauty.world

# SQLite (Easypanel volume /app/data)
DATABASE_PATH=/app/data/velora.sqlite

# Stripe — set in Easypanel secrets only (never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
CARD_PAYMENT_ENABLED=true
NEXT_PUBLIC_CARD_PAYMENT_ENABLED=false
NEXT_PUBLIC_SNAP_PIXEL_ID=628f12d8-df4e-4272-889a-4806255011cd


# Bayla profit admin (/bayla-admin) — server only
BAYLA_ADMIN_PASSWORD=
BAYLA_ADMIN_SESSION_SECRET=
# BAYLA_ADMIN_SESSION_MAX_AGE_SECONDS=86400
# Optional unit economics (USD) — see docs/BAYLA-ADMIN-EASYPANEL.md
# BAYLA_AED_PER_USD=3.6725
# BAYLA_STRIPE_FEE_PERCENT=5.4
# BAYLA_STRIPE_FEE_FIXED_USD=0.30
# BAYLA_CARD_SHIPPING_USD=5.99
# BAYLA_PRODUCT_COST_EYE_USD=3
# BAYLA_PRODUCT_COST_SKIN_USD=7.47
# BAYLA_COD_CALL_NO_ANSWER_USD=0.50
# BAYLA_COD_CALL_RETURNED_USD=1.00
# BAYLA_COD_CALL_DELIVERED_USD=2.00
# BAYLA_COD_SHIPPING_RETURNED_USD=4.99
# BAYLA_COD_SHIPPING_DELIVERED_USD=5.99
# BAYLA_COD_SERVICE_FEE_PERCENT=5

# Redirect Killer admin (/redirectkiller) — server only, never commit real values
REDIRECTKILLER_ADMIN_PASSWORD=
REDIRECTKILLER_SESSION_SECRET=
# Optional: session lifetime in seconds (900–1209600, default 86400)
# REDIRECTKILLER_SESSION_MAX_AGE_SECONDS=86400
# Optional: comma-separated extra internal paths allowed as redirect targets
# REDIRECTKILLER_EXTRA_DESTINATIONS=/checkout/cod
# Optional: JSON map of /ads/{slug} defaults when SQLite has no row (DB wins)
# REDIRECTKILLER_BUILTIN_REDIRECTS_JSON={"hair-ads":"/products/hair-gummies"}

# Abandoned-checkout backend (server only — never prefix with NEXT_PUBLIC_)
# Origin only, no path. Example: https://api.velorabeauty.world
BACKEND_API_BASE_URL=https://api.velorabeauty.world
STORE_API_KEY=
# The backend sweep marks a quiet checkout abandoned. Do not poll /api/checkouts.
