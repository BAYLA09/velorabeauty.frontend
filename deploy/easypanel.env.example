# Easypanel → Service → Environment (copy each line; fill secrets in panel only)
# Do NOT commit live keys to Git.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/velora.sqlite
SITE_URL=https://www.velorabeauty.world

# Auto-deploy after GitHub "Publish container" (Docker Image service — not Git source):
# 1) Easypanel → Deployments → Webhook → copy URL into EASYPANEL_DEPLOY_WEBHOOK
# 2) Generate a long random string → DEPLOY_TRIGGER_SECRET here AND GitHub Actions secret (same value)
# EASYPANEL_DEPLOY_WEBHOOK=
# DEPLOY_TRIGGER_SECRET=

# Optional: GitHub PAT (read-only) so /api/health can compare live version to main (if VPS blocks api.github.com)
# GITHUB_HEALTH_TOKEN=ghp_...

# Snap Pixel — baked into the Docker image at build time (GitHub Publish container).
# Setting this only in Easypanel runtime env does NOT update an existing GHCR image.
# After merge: wait for Actions → Publish container, then Easypanel → Deploy (pull latest).
NEXT_PUBLIC_SNAP_PIXEL_ID=628f12d8-df4e-4272-889a-4806255011cd

# COD thank-you — WhatsApp / phone (public, safe for browser)
# NEXT_PUBLIC_SUPPORT_WHATSAPP=9715XXXXXXXX
# NEXT_PUBLIC_SUPPORT_PHONE=+971 5 XXX XXXX

# Card checkout (required for Stripe)
CARD_PAYMENT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Hidden ~1 USD Stripe Live test (checkout only — /checkout/stripe-test)
# STRIPE_TEST_CHECKOUT_ENABLED=true
# STRIPE_TEST_CHECKOUT_TOKEN=optional-secret

# Abandoned-cart backend (optional but recommended)
BACKEND_API_BASE_URL=https://api.velorabeauty.world
STORE_API_KEY=

# Google Sheets — pick ONE path (recommended: Service Account API, no Apps Script):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...full JSON...}
# ORDERS_SHEETS_SPREADSHEET_ID=1nasdcXYD5ihxj5QnGMWQ05ug3VqoVfgP8R9ojBnsjXQ
# ORDERS_SHEETS_SHEET_GID=469291840
#
# Legacy Apps Script webhook (optional if API above is set):
ORDERS_SHEETS_WEBHOOK_SECRET=
ORDERS_SHEETS_COD_WEBHOOK_URL=
# Paid card (same /exec URL OK — redeploy Apps Script with CARD_SPREADSHEET_ID defaults):
# ORDERS_SHEETS_CARD_WEBHOOK_URL=
# ORDERS_SHEETS_CARD_SPREADSHEET_ID=1paLygQEeE3V6kUVd4PP60v_xhpKp4e7Xu_UK3L5y32A
# ORDERS_SHEETS_CARD_SHEET_GID=1628433865
# Inbound COD status sync cutoff (aliases: ORDERS_STATUS_CUTOFF_ISO, ORDERS_SHEETS_SYNC_CUTOFF_ISO)
# COD_NETWORK_STATUS_CUTOFF_ISO=2026-10-18T12:00:00.000Z
# COD_NETWORK_WEBHOOK_SECRET=
# COD_NETWORK_API_TOKEN=
# COD_NETWORK_MATCH_WINDOW_HOURS=72
# ORDERS_SHEETS_WEBHOOK_URL=
