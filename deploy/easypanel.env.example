# Easypanel → Service → Environment (copy each line; fill secrets in panel only)
# Do NOT commit live keys to Git.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/velora.sqlite
SITE_URL=https://www.velorabeauty.world

# Card checkout (required for Stripe)
CARD_PAYMENT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Abandoned-cart backend (optional but recommended)
BACKEND_API_BASE_URL=https://api.velorabeauty.world
STORE_API_KEY=

# Google Sheets order export (optional — two sheets: COD + card paid)
ORDERS_SHEETS_WEBHOOK_SECRET=
ORDERS_SHEETS_COD_WEBHOOK_URL=
ORDERS_SHEETS_CARD_WEBHOOK_URL=
# Optional fallback if COD/CARD URLs omitted:
# ORDERS_SHEETS_WEBHOOK_URL=
